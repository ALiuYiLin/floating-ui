{
  // 编辑器（VSCode 等）对 test/*.tsx 的 JSX 类型检查配置：
  // `jsxImportSource: @actview/jsx` 让 TS 从 @actview/jsx 解析 JSX 类型
  // （默认 react-jsx 会找 react/jsx-runtime，测试模块报"找不到模块路径"）。
  // 已加入 tsconfig.json 的 references（对齐 packages/react 的模式）——
  // 编辑器与 `tsc -b` 现在都会检查 test 文件；测试文件存在若干既有类型
  // 错误（Ref vs 原始值、implicit any 等），修复后 tsc -b 可全绿。
  "extends": "config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc",
    "jsx": "react-jsx",
    "jsxImportSource": "@actview/jsx",
    // 测试代码类型不严谨（implicit any、Ref vs 原始值等）属既有状态：
    // 关掉 strict 严格模式，让 tsc -b / 编辑器对 test 文件只做基础检查
    // （lib 的 tsconfig.lib.json 保持 strict 不变）。
    "strict": false,
    // FIXME: resize-observer-polyfill is conflicting with DOM typings
    "skipLibCheck": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["test", "vite.config.mts"],
  "references": [{"path": "./tsconfig.lib.json"}]
}
